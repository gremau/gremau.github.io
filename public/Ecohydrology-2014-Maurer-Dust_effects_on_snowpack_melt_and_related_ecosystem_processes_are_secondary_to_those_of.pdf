         <dc:subject>
            <rdf:Bag>
               <rdf:li>10.1002/eco.1558 and ecohydrology; soil respiration; decomposition; snow hydrology; winter biogeochemistry</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Dust effects on snowpack melt and related ecosystem processes are secondary to those of forest canopy structure and interannual snowpack variability</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
